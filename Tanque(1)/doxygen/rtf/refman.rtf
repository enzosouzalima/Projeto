72         OCR0A = 205;  {\cf20 // Desliga motor}\par
73         OCR2A = 144;  {\cf20 // Desliga motor}\par
74         {\cf20 //PORTD &= ~((1 << MOTOR1_TRAS) | (1 << MOTOR2_TRAS));}\par
75     \} \par
76     {\cf19 else} {\cf19 if} (direita == (1 << SINAL_B)) \{\par
77         {\cf20 // Ligar MOTOR1_frente 60% e MOTOR2_frente 80%}\par
78         {\cf20 // Desliga MOTOR1_TRAS e MOTOR2_TRAS}\par
79         OCR2B = 144;   {\cf20 // Ajuste para 60% do ciclo de trabalho}\par
80         OCR0B = 205;  {\cf20 // Ajuste para 80% do ciclo de trabalho}\par
81         OCR0A = 0;  {\cf20 // Desliga motor}\par
82         OCR2A = 0;  {\cf20 // Desliga motor}\par
83         {\cf20 //PORTD &= ~((1 << MOTOR1_TRAS) | (1 << MOTOR2_TRAS));}\par
84     \} \par
85     {\cf19 else} {\cf19 if} (atras == (1 << SINAL_D)) \{\par
86         {\cf20 // Ligar MOTOR1_TRAS e MOTOR2_TRAS 80%}\par
87         {\cf20 // Desliga MOTOR1_FRENTE e MOTOR2_FRENTE}\par
88         OCR0A = 205;  {\cf20 // Ajuste para 80% do ciclo de trabalho}\par
89         OCR2A = 0;  {\cf20 // Desliga motor}\par
90         OCR0B = 0;  {\cf20 // Desliga motor}\par
91         OCR2B = 205;  {\cf20 // Ajuste para 80% do ciclo de trabalho}\par
92         {\cf20 //PORTD &= ~((1 << MOTOR1_FRENTE) | (1 << MOTOR2_FRENTE));}\par
93     \} \par
94     {\cf19 else} \{\par
95         OCR0A = 0;  {\cf20 // Desliga motor}\par
96         OCR2A = 0;  {\cf20 // Desliga motor}\par
97         OCR0B = 0;  {\cf20 // Desliga motor}\par
98         OCR2B = 0;  {\cf20 // Desliga motor}\par
99         {\cf20 // Desliga MOTOR1_FRENTE, MOTOR2_FRENTE, MOTOR1_TRAS e MOTOR2_TRAS}\par
