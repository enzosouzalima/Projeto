{
\pard\plain \s41\li360\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 51                      \{\par
52     {\cf20 // Ler os sinais de entrada nas portas PC1, PC2, PC3, PC4}\par
53     uint8_t frente = PINC & (1 << SINAL_A);\par
54     uint8_t direita = PINC & (1 << SINAL_B);\par
