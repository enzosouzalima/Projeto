59         {\cf20 // Ligar MOTOR1_FRENTE e MOTOR2_FRENTE 65%}\par
60         {\cf20 // Desliga MOTOR1_TRAS e MOTOR2_TRAS}\par
61         OCR2B = 0;  {\cf20 // Ajuste para 80% do ciclo de trabalho}\par
62         OCR0B = 205;  {\cf20 // Desliga motor}\par
