64         OCR2A = 205;  {\cf20 // Ajuste para 80% do ciclo de trabalho}\par
65         {\cf20 //PORTD &= ~((1 << MOTOR1_TRAS) | (1 << MOTOR2_TRAS));}\par
66     \} \par
