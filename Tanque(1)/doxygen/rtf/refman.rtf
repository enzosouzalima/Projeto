{\bkmkstart AAAAAAAAAV}
{\bkmkend AAAAAAAAAV}
{
\pard\plain \s61\li360\sa60\sb30\qj\widctlpar\qj\adjustright \fs20\cgrid 
{
\pard\plain \s41\li360\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 141            \{\par
142   \par
143     ADCSRA |= (1 << ADEN); {\cf20 // Habilita o ADC}\par
144     \par
145     timer1_init(); {\cf20 // Inicializa o timer1}\par
146     timer0_init(); {\cf20 // Inicializa o timer0}\par
147     timer2_init(); {\cf20 // Inicializa o timer2}\par
148     \par
149     DDRB |= (1 << LASER_PIN) | (1 << MOTOR1_FRENTE); {\cf20 // Configura como pinos de sa\'EDda}\par
150 \par
151     DDRD |= (1 << LED_VIDA1) | (1 << LED_VIDA2) | (1 << LED_VIDA3) |\par
152             (1 << MOTOR1_TRAS) | (1 << MOTOR2_FRENTE) | (1 << MOTOR2_TRAS); {\cf20 // Configura como pinos de sa\'EDda}\par
153 \par
154     DDRC &= ~((1 << SENSOR_LDR) | (1 << SINAL_A) | (1 << SINAL_B) |\par
155               (1 << SINAL_C) | (1 << SINAL_D) | (1 << RESET_VIDAS)); {\cf20 // Configura como pinos de entrada}\par
156               \par
157     PORTD |= (1 << LED_VIDA1) | (1 << LED_VIDA2) | (1 << LED_VIDA3); {\cf20 // Acende os LEDs quando o sistema e' ligado}\par
158     \par
159     {\cf20 // Main Loop}\par
160     {\cf19 while} (1) \{\par
161         {\cf20 // Verifica se o bot\'E3o na porta PC5 est\'E1 pressionado}\par
162         {\cf19 if} (!(PINC & (1 << RESET_VIDAS))) \{\par
163             PORTD |= (1 << LED_VIDA1) | (1 << LED_VIDA2) | (1 << LED_VIDA3); {\cf20 // Acende os LEDs assim resetando as vidas}\par
164         \}\par
165     \}\par
166     {\cf19 return} 0;\par
167 \}\par
}
}
