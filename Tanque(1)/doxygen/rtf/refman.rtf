\pard\plain \s41\li360\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 111                      \{\par
112     \par
113     {\cf20 // Selecionar o canal ADC (por exemplo, ADC0 para o pino PC0)}\par
114     ADMUX &= 0xF0;          {\cf20 // Limpar os bits de sele\'E7\'E3o de canal}\par
115     ADMUX |= SENSOR_LDR; {\cf20 // Configurar o canal ADC (por exemplo, para o pino PC0)}\par
116 \par
117     {\cf20 // Iniciar a convers\'E3o}\par
118     ADCSRA |= (1 << ADSC);\par
119 \par
120     {\cf20 // Aguardar o t\'E9rmino da convers\'E3o}\par
121     {\cf19 while} (ADCSRA & (1 << ADSC));\par
122 \par
123     uint16_t ldr_value = ADC;\par
124 \par
125     {\cf19 if} ((PIND & (1 << LED_VIDA1)) && (PIND & (1 << LED_VIDA2)) && (PIND & (1 << LED_VIDA3)) && (ldr_value < 450)) \{\par
126             \par
127             PORTD &= ~(1 << LED_VIDA3);{\cf20 // Desliga o LED_VIDA3}\par
128             _delay_ms(5000);\par
129     \}\par
130     {\cf19 else} {\cf19 if} ((PIND & (1 << LED_VIDA1)) && (PIND & (1 << LED_VIDA2)) && (ldr_value < 450)) \{\par
131             \par
132             PORTD &= ~(1 << LED_VIDA2);{\cf20 // Desliga o LED_VIDA2}\par
133             _delay_ms(5000);\par
134     \}\par
135     {\cf19 else} {\cf19 if} ((PIND & (1 << LED_VIDA1)) && (ldr_value < 450)) \{\par
136             \par
137             PORTD &= ~(1 << LED_VIDA1);{\cf20 // Desliga o LED_VIDA1}\par
138             _delay_ms(5000);\par
139     \}\par
140 \}\par
}
