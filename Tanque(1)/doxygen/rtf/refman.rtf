68         {\cf20 // Ligar MOTOR1_frente 80% e MOTOR2_frente 60%}\par
69         {\cf20 // Desliga MOTOR1_TRAS e MOTOR2_TRAS}\par
70         OCR2B = 0;  {\cf20 // Ajuste para 80% do ciclo de trabalho}\par
